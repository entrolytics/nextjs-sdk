{
  "name": "@entrolytics/nextjs-sdk",
  "version": "3.0.2",
  "description": "Next.js SDK for Entrolytics - First-party growth analytics for the edge",
  "keywords": [
    "analytics",
    "deployment-tracking",
    "entrolytics",
    "form-analytics",
    "nextjs",
    "privacy",
    "react",
    "tracking",
    "web-analytics",
    "web-vitals"
  ],
  "homepage": "https://entrolytics.dev",
  "bugs": {
    "url": "https://github.com/entrolytics/nextjs-sdk/issues"
  },
  "license": "MIT",
  "author": "Entrolytics <hey@entrolytics.dev>",
  "repository": {
    "type": "git",
    "url": "https://github.com/entrolytics/nextjs-sdk.git",
    "directory": "entro-nextjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server/index.d.ts",
        "default": "./dist/server/index.mjs"
      },
      "require": {
        "types": "./dist/server/index.d.ts",
        "default": "./dist/server/index.cjs"
      }
    },
    "./plugin": {
      "import": {
        "types": "./dist/plugin/index.d.ts",
        "default": "./dist/plugin/index.mjs"
      },
      "require": {
        "types": "./dist/plugin/index.d.ts",
        "default": "./dist/plugin/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && tsc --emitDeclarationOnly --noEmit false",
    "check": "pnpm lint:check && pnpm typecheck",
    "dev": "tsdown --watch",
    "lint": "oxlint --fix . && oxfmt --write .",
    "lint:check": "oxlint . && oxfmt --check .",
    "lint:fix-unsafe": "oxlint -f stylish --import-plugin --type-aware --type-check --vitest-plugin --fix --fix-suggestions --fix-dangerously src/",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@entrolytics/shared": "^3.2.1",
    "@entrolytics/trpc-client": "^3.1.1",
    "@tanstack/react-query": "^5.108.4",
    "@trpc/client": "^11.31.4",
    "@trpc/next": "^11.31.4",
    "@trpc/react-query": "^11.31.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "next": "^16.4.6",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "react": "latest",
    "react-dom": "latest",
    "tsdown": "^0.23.7",
    "typescript": "next",
    "vitest": "^5.1.2"
  },
  "peerDependencies": {
    "next": ">=16.0.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "peerDependenciesMeta": {
    "web-vitals": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "web-vitals": "^6.2.3"
  },
  "engines": {
    "node": ">=24.22.3"
  },
  "packageManager": "pnpm@12.24.0"
}
